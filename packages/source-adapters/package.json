{
  "name": "@muxaro/source-adapters",
  "version": "1.0.0",
  "type": "module",
  "description": "Source media adapters, metadata inspection, rights declaration validation, and permitted preview engines for Project MUXARO",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/run-all-tests.ts",
    "test:extractor": "node --experimental-strip-types tests/youtube-adapter.test.ts",
    "test:ipv6": "node --experimental-strip-types tests/ipv6-rotator.test.ts",
    "test:manifest": "node --experimental-strip-types tests/streaming-manifest-resolver.test.ts",
    "test:direct": "node --experimental-strip-types tests/direct-adapter.test.ts",
    "test:youtube": "node --experimental-strip-types tests/youtube-permitted-adapter.test.ts",
    "test:rights": "node --experimental-strip-types tests/rights-validator.test.ts",
    "test:registry": "node --experimental-strip-types tests/adapter-registry.test.ts",
    "test:ssrf": "node --experimental-strip-types tests/ssrf-filter.test.ts"
  },
  "keywords": [
    "muxaro",
    "media-adapters",
    "source-adapters",
    "direct-media",
    "youtube-permitted",
    "rights-verification",
    "oembed",
    "metadata-inspection"
  ],
  "author": "Subhransu Nayak",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
