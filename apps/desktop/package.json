{
  "name": "@muxaro/desktop",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "MUXARO Local Desktop Studio — Standalone Offline Video, PDF & Media Workstation",
  "main": "dist/main.js",
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "prepare:web": "node scripts/copy-web.mjs",
    "build": "npm run build:ts && npm run prepare:web && electron-builder --win portable --x64"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "^42.11.16",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3"
  },
    "build": {
    "appId": "app.muxaro.desktop",
    "productName": "MUXARO",
    "compression": "store",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "web-dist",
        "to": "web-dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MUXARO-Studio-Windows-x64.exe"
    },
    "portable": {}
  }
}
