{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@muxaro/shared": ["../../packages/shared/src/index.ts"],
      "@muxaro/shared/*": ["../../packages/shared/src/*"],
      "@muxaro/db": ["../../packages/db/src/index.ts"],
      "@muxaro/db/*": ["../../packages/db/src/*"]
    }
  },
  "include": [
    "src/server.ts",
    "src/index.ts",
    "src/plugins/**/*",
    "src/routes/analyse.ts",
    "src/routes/uploads.ts",
    "src/routes/jobs.ts",
    "src/routes/downloads.ts",
    "src/routes/status.ts",
    "src/routes/usage.ts",
    "src/lib/**/*",
    "tests/v1-api.test.ts"
  ]
}
