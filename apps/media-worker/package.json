{
  "name": "@muxaro/media-worker",
  "version": "1.0.0",
  "type": "module",
  "description": "Production FFmpeg and FFprobe media processing worker service for Muxaro",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "keywords": [
    "ffmpeg",
    "ffprobe",
    "transcoder",
    "media-worker",
    "stream-copy",
    "remux",
    "audio-extractor"
  ],
  "author": "Muxaro Core Team",
  "license": "MIT",
  "dependencies": {
    "archiver": "^8.0.0",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
