{
  "name": "@vyro/tests",
  "version": "1.0.0",
  "description": "Comprehensive Independent QA, Concurrency, Security, Media, and Integration Test Suite for Project VYRO",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types tests/run-all.ts",
    "test:unit": "node --experimental-strip-types tests/unit/run-unit.ts",
    "test:concurrency": "node --experimental-strip-types tests/concurrency/quota-race.test.ts",
    "test:security": "node --experimental-strip-types tests/security/ssrf-regression.test.ts",
    "test:redteam": "node ../apps/api/node_modules/tsx/dist/cli.mjs security/redteam-pentest.test.ts",
    "test:media": "node --experimental-strip-types tests/media/media-engine.test.ts",
    "test:integration": "node --experimental-strip-types tests/integration/api-integration.test.ts",
    "test:load": "node --experimental-strip-types qa/load/load-simulation.ts"
  },
  "keywords": [
    "qa",
    "testing",
    "media-engine",
    "ssrf-regression",
    "concurrency",
    "quota-race",
    "load-testing"
