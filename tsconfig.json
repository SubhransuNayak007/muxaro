{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "dom", "dom.iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./apps/web/*"],
      "@muxaro/media-splicer": ["./apps/web/lib/media-splicer/index.ts"],
      "@muxaro/media-splicer/*": ["./apps/web/lib/media-splicer/*"]
    }
  },
  "include": [
    "apps/web/app/**/*",
    "apps/web/components/**/*",
    "apps/web/lib/**/*",
    "apps/web/tests/**/*"
  ],
  "exclude": [
    "apps/web/node_modules",
    "apps/web/.next"
  ]
}
