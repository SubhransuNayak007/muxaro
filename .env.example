# ==============================================================================
# MUXARO Platform Environment Configuration Template (.env.example)
# Copy to `.env` for local development. NEVER commit real secrets to Git!
# In production, inject server secrets via Google Secret Manager / Cloudflare Secrets.
# ==============================================================================

# ==============================================================================
# 1. FRONTEND PUBLIC VARIABLES (Safe to expose to browser via Next.js / CF Pages)
# ==============================================================================
# Canonical public web origin (e.g. https://muxaro.app in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public API origin (e.g. https://api.muxaro.app in production; leave empty for local Next.js rewrite proxy)
NEXT_PUBLIC_API_URL=

# Optional Google Analytics 4 & Google Tag Manager (strictly opt-in via Consent Mode v2; leave empty to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=

# Next.js build-time mode flags (set CLOUDFLARE_PAGES=1 only when exporting static bundle to apps/web/out/)
CLOUDFLARE_PAGES=0
API_INTERNAL_URL=http://127.0.0.1:4000

# ==============================================================================
# 2. API SERVER RUNTIME & NETWORKING (apps/api)
# ==============================================================================
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Public API & Frontend URLs used for OAuth callbacks, signed download URLs, and CORS
# API_BASE_URL takes precedence over BASE_URL if both are set
API_BASE_URL=http://localhost:4000
BASE_URL=http://localhost:4000
SITE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Exact allowed browser origin(s), comma-separated (e.g. https://muxaro.app in production)
CORS_ORIGIN=http://localhost:3000

# Set to `true` ONLY when behind a trusted ingress reverse proxy (Cloudflare / Cloud Run LB)
TRUST_PROXY=false

# Multi-layer anti-abuse rate limiter (keep `true` in production)
RATE_LIMIT_ENABLED=true

# Request body limit & media pipeline settings
MAX_PAYLOAD_BYTES=10485760
WORKER_CONCURRENCY=4
STORAGE_DIR=./storage/scratch

# ==============================================================================
# 3. SERVER CRYPTOGRAPHIC SECRETS (REQUIRED IN PRODUCTION — generate 32+ random bytes)
#    Generate with: openssl rand -hex 32
# ==============================================================================
SESSION_SECRET=replace-with-64-char-random-hex-secret
SIGNED_TOKEN_SECRET=replace-with-64-char-random-hex-secret
MFA_ENCRYPTION_KEY=replace-with-64-char-random-hex-secret

# Optional comma-separated email allowlist for initial Admin role promotion (still requires TOTP MFA!)
MUXARO_ADMIN_EMAIL=

# ==============================================================================
# 4. DATABASE & CACHE (SQLite WAL local / PostgreSQL Supabase or Cloud SQL prod)
# ==============================================================================
# Local SQLite database file path (Node 24 built-in node:sqlite WAL store)
MUXARO_DB_PATH=.muxaro-data/muxaro.db

# Production PostgreSQL connection string (e.g. Supabase pooler or Cloud SQL)
DATABASE_URL=

# Optional Redis URL for multi-replica distributed rate limiting & queues
REDIS_URL=

# ==============================================================================
# 5. CLOUDFLARE R2 OBJECT STORAGE (S3-Compatible, SigV4 — falls back to local disk when unset)
# ==============================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=muxaro-media
R2_REGION=auto
# Optional custom S3 endpoint override (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=
R2_PUBLIC_ENDPOINT=

# ==============================================================================
# 6. GOOGLE OAUTH 2.0 (Authorization Code + PKCE S256 — leave empty to keep Google Sign-In cleanly disabled)
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production example: https://api.muxaro.app/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# ==============================================================================
# 7. GOOGLE AD MANAGER REWARDED ADS & SSV (Optional — UI stays hidden unless configured)
# ==============================================================================
REWARDED_ADS_ENABLED=false
GAM_REWARDED_AD_UNIT_PATH=
GAM_SSV_KEY_URL=https://www.gstatic.com/admob/reward/verifier-keys.json
REWARD_SESSION_TTL_SECONDS=300
# Optional test-only ECDSA PEM public key for deterministic local SSV testing (leave empty in production)
GAM_SSV_PUBLIC_KEY_PEM=
GAM_SSV_TEST_KEY_ID=

# ==============================================================================
# 8. TRANSACTIONAL EMAIL (Optional — writes verification/reset links to local dev-outbox.jsonl when unset)
# ==============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@muxaro.app

# ==============================================================================
# 9. MEDIA WORKER SERVICE (apps/media-worker — Internal Cloud Run Service)
# ==============================================================================
MEDIA_WORKER_URL=
SCRATCH_DIR=/tmp/muxaro-scratch
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=540
# Optional explicit binary paths (defaults to `ffmpeg` and `ffprobe` on system PATH)
FFMPEG_PATH=
FFPROBE_PATH=
