# ==============================================================================
# MUXARO Frontend Environment Configuration (.env.example)
# Copy to `apps/web/.env.local` for local development.
# ==============================================================================

# Canonical public web origin (e.g. https://muxaro.vercel.app in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional external API endpoint if connecting the UI to a compatible media API
NEXT_PUBLIC_API_URL=

# Optional Cloudflare Turnstile Public Site Key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional Google Analytics 4 & Google Tag Manager (strictly opt-in via Consent Mode v2)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=

# Set CLOUDFLARE_PAGES=1 only when building a static export to apps/web/out/
CLOUDFLARE_PAGES=0
