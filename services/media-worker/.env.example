# ==============================================================================
# MUXARO Dedicated Media Worker - Environment Configuration Template
# Copy this file to .env before starting the worker container or local service:
#   cp .env.example .env
# ==============================================================================

# Server Network Configuration
PORT=5001
HOST=0.0.0.0
NODE_ENV=production

# CORS Security (comma-separated origins or * for open access)
# Examples:
#   ALLOWED_ORIGINS=https://muxaro.vercel.app,http://localhost:3000
#   ALLOWED_ORIGINS=*
ALLOWED_ORIGINS=*

# Stream Safety & Resource Limits (Optimized for Render Free / Oracle Cloud Free)
# Maximum media file size allowed for stream copying (in Megabytes)
MAX_FILE_SIZE_MB=500

# Maximum concurrent stream-copy operations per instance
MAX_CONCURRENT_STREAMS=5

# Timeout thresholds (in seconds)
STREAM_TIMEOUT_SECONDS=300
PROBE_TIMEOUT_SECONDS=8

# Logging Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Optional: Redis Configuration
# Only used if starting with background queue profile: docker compose --profile queue up -d
# ------------------------------------------------------------------------------
# REDIS_URL=redis://:muxaro_redis_secret@redis:6379/0
# REDIS_PASSWORD=muxaro_redis_secret
# REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Optional: Cloudflare R2 / S3 Configuration
# Only used if uploading persistent artifacts with pre-signed download URLs
# ------------------------------------------------------------------------------
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_ARTIFACTS=muxaro-artifacts
# S3_PRESIGNED_TTL_SECONDS=3600
