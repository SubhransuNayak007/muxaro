# ==============================================================================
# MUXARO Analyse Worker Container (BullMQ lane:analyse, metadata extractor)
# Multi-stage lightweight production container: Node 22, Tini, non-root user muxaro
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build & Dependencies
# ------------------------------------------------------------------------------
FROM node:25-bookworm-slim AS builder

WORKDIR /app

# Install build dependencies for native modules if required
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy monorepo workspace configuration files
COPY package.json* package-lock.json* pnpm-lock.yaml* pnpm-workspace.yaml* ./

# Copy shared packages manifests
COPY packages/shared/package*.json ./packages/shared/
COPY packages/db/package*.json ./packages/db/

# Copy worker-analyse package manifest
COPY apps/worker-analyse/package*.json ./apps/worker-analyse/

# Install dependencies
RUN if [ -f package-lock.json ]; then \
      npm ci --no-audit --no-fund; \
    elif [ -f apps/worker-analyse/package.json ]; then \
      cd apps/worker-analyse && if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi; \
    fi

# Copy source code
COPY packages/shared ./packages/shared
COPY packages/db ./packages/db
COPY apps/worker-analyse ./apps/worker-analyse

# Build TypeScript packages
RUN if [ -d packages/shared ] && [ -f packages/shared/tsconfig.json ]; then cd packages/shared && npx tsc -b 2>/dev/null || npx tsc 2>/dev/null || true; fi && \
    if [ -d packages/db ] && [ -f packages/db/tsconfig.json ]; then cd packages/db && npx tsc -b 2>/dev/null || npx tsc 2>/dev/null || true; fi && \
    if [ -d apps/worker-analyse ] && [ -f apps/worker-analyse/tsconfig.json ]; then cd apps/worker-analyse && npx tsc 2>/dev/null || true; fi

# ------------------------------------------------------------------------------
# Stage 2: Lightweight Production Runtime
# ------------------------------------------------------------------------------
FROM node:25-bookworm-slim AS runner

LABEL maintainer="Muxaro Engineering <ops@muxaro.com>"
LABEL org.opencontainers.image.title="muxaro-worker-analyse"
LABEL org.opencontainers.image.description="MUXARO Lightweight Metadata & Stream Analyse Worker"

WORKDIR /app

# Install minimal lightweight runtime utilities: Tini (PID 1 reaper), curl (healthcheck), ca-certificates
RUN apt-get update && apt-get install -y --no-install-recommends \
    tini \
    curl \
    ca-certificates \
    && apt-get purge -y --auto-remove \
    && rm -rf /var/lib/apt/lists/* /root/.cache

# Dedicated unprivileged non-root system user (UID 10001)
RUN groupadd --system --gid 10001 muxaro && \
    useradd --system --uid 10001 --gid muxaro --no-create-home --shell /usr/sbin/nologin muxaro

# Copy built artifacts from builder
COPY --from=builder --chown=muxaro:muxaro /app /app

# Runtime configuration defaults
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=5001
ENV LOG_LEVEL=info
ENV BULLMQ_CONCURRENCY=30

WORKDIR /app/apps/worker-analyse

# Switch to unprivileged non-root user
USER 10001:10001

# Expose internal telemetry and healthcheck port
EXPOSE 5001

# Periodic healthcheck probing internal /health endpoint
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${PORT:-5001}/health" || exit 1

# Tini acts as PID 1 to handle signals cleanly
ENTRYPOINT ["/usr/bin/tini", "--"]

# Launch analyse worker runtime
CMD ["sh", "-c", "if [ -f dist/index.js ]; then node dist/index.js; else npm start; fi"]
