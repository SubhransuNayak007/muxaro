# ==============================================================================
# MUXARO Platform Environment Configuration Template
# Copy this file to .env before starting services
# ==============================================================================

# General Environment
NODE_ENV=production
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5432
POSTGRES_DB=muxaro_db
POSTGRES_USER=muxaro_user
POSTGRES_PASSWORD=muxaro_secure_password
DATABASE_URL=postgres://muxaro_user:muxaro_secure_password@postgres:5432/muxaro_db

# ------------------------------------------------------------------------------
# Redis Cache & Queue Broker
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=6379
REDIS_PASSWORD=muxaro_redis_secret
REDIS_URL=redis://:muxaro_redis_secret@redis:6379/0

# ------------------------------------------------------------------------------
# Object Storage: S3 / MinIO
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_UPLOADS=muxaro-uploads
S3_BUCKET_ARTIFACTS=muxaro-artifacts
S3_FORCE_PATH_STYLE=true

# MinIO Local Management Ports & Credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# Fastify REST API Service
# ------------------------------------------------------------------------------
API_PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=change-this-to-a-cryptographically-random-64-char-hex-string
JWT_SECRET=change-this-to-a-cryptographically-random-64-char-hex-string
MEDIA_WORKER_URL=http://media-worker:5000

# ------------------------------------------------------------------------------
# FFmpeg Media Worker Service
# ------------------------------------------------------------------------------
MEDIA_WORKER_PORT=5000
SCRATCH_DIR=/tmp/muxaro-scratch
MAX_CONCURRENT_JOBS=4
JOB_TIMEOUT_SECONDS=120

# ------------------------------------------------------------------------------
# Next.js Web Frontend
# ------------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# AWS Production Infrastructure (Used in IaC & Cloud Deployment)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_DEFAULT_OUTPUT=json
SQS_MEDIA_JOBS_URL=https://sqs.us-east-1.amazonaws.com/123456789012/muxaro-media-jobs
SQS_MEDIA_JOBS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/123456789012/muxaro-media-jobs-dlq
