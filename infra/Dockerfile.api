# ==============================================================================
# MUXARO API Gateway Service (Fastify 5 REST & SSE Gateway)
# Multi-stage production container: Node 24 (node:sqlite), Tini, FFmpeg, yt-dlp nightly, Deno, bgutil plugin
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build & Dependencies
# ------------------------------------------------------------------------------
FROM node:24-bookworm-slim AS builder

WORKDIR /app

# Install build dependencies for native modules if required
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy monorepo workspace configuration files
COPY package.json* package-lock.json* pnpm-lock.yaml* pnpm-workspace.yaml* ./

# Copy shared & security packages manifests
COPY packages/shared/package*.json ./packages/shared/
COPY packages/db/package*.json ./packages/db/
COPY packages/entitlements/package*.json ./packages/entitlements/
COPY packages/source-adapters/package*.json ./packages/source-adapters/
COPY security/package*.json ./security/

# Copy API package manifest
COPY apps/api/package*.json ./apps/api/

# Install dependencies across API and workspace packages
RUN for dir in packages/shared packages/db packages/entitlements packages/source-adapters security apps/api; do \
      if [ -f "/app/${dir}/package-lock.json" ]; then \
        (cd "/app/${dir}" && npm ci --no-audit --no-fund); \
      elif [ -f "/app/${dir}/package.json" ]; then \
        (cd "/app/${dir}" && npm install --no-audit --no-fund); \
      fi; \
    done

# Copy source code
COPY packages/shared ./packages/shared
COPY packages/db ./packages/db
COPY packages/entitlements ./packages/entitlements
COPY packages/source-adapters ./packages/source-adapters
COPY security ./security
COPY apps/api ./apps/api

# Build TypeScript packages where emit is enabled
RUN for dir in packages/shared packages/db packages/entitlements packages/source-adapters; do \
      if [ -f "/app/${dir}/tsconfig.json" ]; then \
        (cd "/app/${dir}" && (npx tsc -b 2>/dev/null || npx tsc 2>/dev/null || true)); \
      fi; \
    done

# ------------------------------------------------------------------------------
# Stage 2: Hardened Production Runtime
# ------------------------------------------------------------------------------
FROM node:24-bookworm-slim AS runner

LABEL maintainer="Muxaro Engineering <ops@muxaro.com>"
LABEL org.opencontainers.image.title="muxaro-api"
LABEL org.opencontainers.image.description="MUXARO Fastify REST & SSE API Gateway"

WORKDIR /app

# Install runtime utilities: Tini (PID 1 reaper), curl, ca-certificates,
# FFmpeg/FFprobe, Deno JS runtime, yt-dlp (latest nightly), and bgutil-ytdlp-pot-provider plugin
RUN apt-get update && apt-get install -y --no-install-recommends \
    tini \
    curl \
    ca-certificates \
    ffmpeg \
    unzip \
    python3 \
    python3-pip \
    && curl -fsSL https://deno.land/install.sh | DENO_INSTALL=/usr/local sh \
    && chmod 0755 /usr/local/bin/deno \
    && curl -fsSL https://github.com/yt-dlp/yt-dlp-nightly-builds/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp \
    && chmod 0755 /usr/local/bin/yt-dlp \
    && python3 -m pip install --no-cache-dir --break-system-packages -U bgutil-ytdlp-pot-provider \
    && ffmpeg -version && ffprobe -version && yt-dlp --version && deno --version \
    && apt-get purge -y --auto-remove \
    && rm -rf /var/lib/apt/lists/* /root/.cache

# Dedicated unprivileged non-root system user (UID 10001)
RUN groupadd --system --gid 10001 muxaro && \
    useradd --system --uid 10001 --gid muxaro --no-create-home --shell /usr/sbin/nologin muxaro

# Copy built artifacts from builder
COPY --from=builder --chown=muxaro:muxaro /app /app

# Create runtime scratch directories for local caching / multipart buffer
RUN mkdir -p /tmp/muxaro-data /tmp/muxaro-artifacts /tmp/muxaro-uploads /tmp/muxaro-scratch && \
    chown -R muxaro:muxaro /tmp/muxaro-data /tmp/muxaro-artifacts /tmp/muxaro-uploads /tmp/muxaro-scratch && \
    chmod 700 /tmp/muxaro-data /tmp/muxaro-artifacts /tmp/muxaro-uploads /tmp/muxaro-scratch

# Runtime configuration defaults (zero developer local paths)
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4000
ENV TRUST_PROXY=true
ENV RATE_LIMIT_ENABLED=true
ENV LOG_LEVEL=info
ENV MUXARO_DB_PATH=/tmp/muxaro-data/muxaro.db
ENV STORAGE_DIR=/tmp/muxaro-scratch
ENV FFMPEG_PATH=/usr/bin/ffmpeg
ENV FFPROBE_PATH=/usr/bin/ffprobe
ENV YTDLP_PATH=/usr/local/bin/yt-dlp
ENV DENO_PATH=/usr/local/bin/deno
ENV YTDLP_JS_RUNTIMES=deno,node

WORKDIR /app/apps/api

# Switch to unprivileged non-root user
USER 10001:10001

# Expose API gateway port
EXPOSE 4000

# Periodic healthcheck probing /api/v1/health or /health
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${PORT:-4000}/api/v1/health" || curl -fsS "http://127.0.0.1:${PORT:-4000}/health" || exit 1

# Tini acts as PID 1 to reap zombie processes
ENTRYPOINT ["/usr/bin/tini", "--"]

# Launch API server
CMD ["sh", "-c", "if [ -f dist/server.js ]; then node dist/server.js; elif [ -f dist/index.js ]; then node dist/index.js; else npm start; fi"]
