{
  "$schema": "https://developers.cloudflare.com/r2/data-access/lifecycle-management/",
  "description": "MUXARO Cloudflare R2 Bucket Lifecycle Configuration (Part 8.3)",
  "version": "1.0",
  "rules": [
    {
      "id": "expire-guest-outputs-60m",
      "enabled": true,
      "description": "Purge temporary guest processed outputs after 60 minutes",
      "conditions": {
        "prefix": "outputs/60m/"
      },
      "action": {
        "type": "Delete",
        "maxAgeSeconds": 3600
      }
    },
    {
      "id": "expire-guest-uploads-60m",
      "enabled": true,
      "description": "Purge temporary guest upload chunks and assembled files after 60 minutes",
      "conditions": {
        "prefix": "uploads/60m/"
      },
      "action": {
        "type": "Delete",
        "maxAgeSeconds": 3600
      }
    },
    {
      "id": "expire-account-outputs-24h",
      "enabled": true,
      "description": "Purge authenticated user job outputs after exactly 24 hours",
      "conditions": {
        "prefix": "outputs/24h/"
      },
      "action": {
        "type": "Delete",
        "maxAgeSeconds": 86400
      }
    },
    {
      "id": "abort-incomplete-multipart-uploads",
      "enabled": true,
      "description": "Abort and purge incomplete multipart upload parts abandoned for >24 hours",
      "conditions": {
        "prefix": ""
      },
      "action": {
        "type": "AbortMultipartUpload",
        "maxAgeSeconds": 86400
      }
    }
  ],
  "s3Compatible": {
    "Rules": [
      {
        "ID": "expire-guest-outputs-60m",
        "Status": "Enabled",
        "Filter": {
          "Prefix": "outputs/60m/"
        },
        "Expiration": {
          "Days": 1
        }
      },
      {
        "ID": "expire-guest-uploads-60m",
        "Status": "Enabled",
        "Filter": {
          "Prefix": "uploads/60m/"
        },
        "Expiration": {
          "Days": 1
        }
      },
      {
        "ID": "expire-account-outputs-24h",
        "Status": "Enabled",
        "Filter": {
          "Prefix": "outputs/24h/"
        },
        "Expiration": {
          "Days": 1
        }
      },
      {
        "ID": "abort-incomplete-multipart-uploads-1d",
        "Status": "Enabled",
        "Filter": {
          "Prefix": ""
        },
        "AbortIncompleteMultipartUpload": {
          "DaysAfterInitiation": 1
        }
      }
    ]
  }
}
