# ==============================================================================
# MUXARO Production Terraform Configuration Values (Example)
# Copy to terraform.tfvars and populate with environment-specific secrets
# ==============================================================================

environment          = "production"
aws_region           = "us-east-1"
domain_name          = "muxaro.com"

# Cloudflare Credentials
cloudflare_api_token = "cf_api_token_here_with_dns_waf_permissions"
cloudflare_zone_id   = "0123456789abcdef0123456789abcdef"

# Networking
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b", "us-east-1c"]

# Database & Cache
db_instance_class    = "db.r6g.xlarge"
db_allocated_storage = 300
db_name              = "muxaro_prod_db"
db_username          = "muxaro_admin"
redis_node_type      = "cache.m6g.large"

# ECS Task Sizing
web_task_cpu         = 1024
web_task_memory      = 2048
web_desired_count    = 12

api_task_cpu         = 2048
api_task_memory      = 4096
api_desired_count    = 10

# Media Transcoding Auto-scaling Fleet (75% Spot for cost efficiency)
worker_min_instances = 20
worker_max_instances = 80
spot_percentage      = 75
