# ==============================================================================
# MUXARO Stateless Media Processing Worker Container
# Isolated FFmpeg / FFprobe + yt-dlp (nightly) + Deno + bgutil PO-token worker
# Security: Non-root (UID 10001), bounded /tmp ephemeral scratch, INTERNAL ingress only
# ==============================================================================

# Stage 1: Dependencies
FROM node:24-bookworm-slim AS deps
WORKDIR /app

COPY apps/media-worker/package.json apps/media-worker/package-lock.json* ./apps/media-worker/

WORKDIR /app/apps/media-worker
RUN if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi

# ------------------------------------------------------------------------------
# Stage 2: Isolated Stateless Worker Runtime
FROM node:24-bookworm-slim AS runner
WORKDIR /app

# Install FFmpeg, FFprobe, yt-dlp (latest nightly), Deno JS runtime, bgutil-ytdlp-pot-provider plugin, tini, curl
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    tini \
    curl \
    ca-certificates \
    unzip \
    python3 \
    python3-pip \
    && curl -fsSL https://deno.land/install.sh | DENO_INSTALL=/usr/local sh \
    && chmod 0755 /usr/local/bin/deno \
    && curl -fsSL https://github.com/yt-dlp/yt-dlp-nightly-builds/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp \
    && chmod 0755 /usr/local/bin/yt-dlp \
    && python3 -m pip install --no-cache-dir --break-system-packages -U bgutil-ytdlp-pot-provider \
    && ffmpeg -version && ffprobe -version && yt-dlp --version && deno --version \
    && apt-get purge -y --auto-remove \
    && rm -rf /var/lib/apt/lists/* /root/.cache

# Dedicated unprivileged worker identity (UID 10001, no login shell)
RUN groupadd --system --gid 10001 mediaworker && \
    useradd --system --uid 10001 --gid mediaworker --no-create-home --shell /usr/sbin/nologin mediaworker

# Copy worker code and dependencies
COPY --from=deps /app/apps/media-worker/node_modules ./apps/media-worker/node_modules
COPY apps/media-worker ./apps/media-worker
COPY security ./security

# Bounded ephemeral scratch volume inside /tmp (auto-purged per job + container lifecycle)
RUN mkdir -p /tmp/muxaro-scratch && \
    chown -R mediaworker:mediaworker /app /tmp/muxaro-scratch && \
    chmod 700 /tmp/muxaro-scratch

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8080
ENV SCRATCH_DIR=/tmp/muxaro-scratch
ENV MAX_CONCURRENT_JOBS=2
ENV JOB_TIMEOUT_SECONDS=540
ENV FFMPEG_PATH=/usr/bin/ffmpeg
ENV FFPROBE_PATH=/usr/bin/ffprobe
ENV YTDLP_PATH=/usr/local/bin/yt-dlp
ENV DENO_PATH=/usr/local/bin/deno
ENV YTDLP_JS_RUNTIMES=deno,node

WORKDIR /app/apps/media-worker

USER 10001:10001

# Internal Cloud Run port only (NEVER exposed with allUsers public IAM)
EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${PORT:-8080}/health" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["npm", "start"]
