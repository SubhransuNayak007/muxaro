# ==============================================================================
# MUXARO Media Transcoder & Remuxing Worker
# Hardened Debian-based image with FFmpeg, FFprobe, and ephemeral scratch
# ==============================================================================

FROM node:20-bookworm-slim AS base

# Install FFmpeg, FFprobe, tini (PID 1 process reaper), curl (healthchecks), and ca-certificates
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    tini \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Verify FFmpeg installation and available codecs
RUN ffmpeg -version && ffprobe -version

WORKDIR /app

# Enable pnpm via corepack
RUN corepack enable && corepack prepare pnpm@latest --activate

# ------------------------------------------------------------------------------
# Stage 2: Dependencies & Build
FROM base AS builder
WORKDIR /app

COPY apps/media-worker/package.json ./apps/media-worker/
COPY apps/media-worker/pnpm-lock.yaml* ./apps/media-worker/

WORKDIR /app/apps/media-worker
RUN pnpm install --frozen-lockfile || npm install

COPY apps/media-worker/ ./
RUN if pnpm run | grep -q "build"; then pnpm run build; fi

# ------------------------------------------------------------------------------
# Stage 3: Production Runtime
FROM base AS runner
WORKDIR /app

# SRE & Security: Create isolated media processing user & group
RUN groupadd --system --gid 1001 mediagroup && \
    useradd --system --uid 1001 --gid mediagroup --create-home mediauser

# Create isolated ephemeral scratch volume for media processing
RUN mkdir -p /tmp/muxaro-scratch && \
    chown -R mediauser:mediagroup /tmp/muxaro-scratch && \
    chmod 700 /tmp/muxaro-scratch

ENV NODE_ENV=production
ENV SCRATCH_DIR=/tmp/muxaro-scratch
ENV PORT=5000
ENV HOST=0.0.0.0

WORKDIR /app/apps/media-worker

COPY --from=builder /app/apps/media-worker/node_modules ./node_modules
COPY --from=builder /app/apps/media-worker/package.json ./package.json
COPY --from=builder /app/apps/media-worker ./

RUN chown -R mediauser:mediagroup /app

USER mediauser

EXPOSE 5000

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://127.0.0.1:5000/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["npm", "start"]
